// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Brand {
  slug    String @id @unique
  name    String
  image   String
  visible Boolean @default(true)

  products Product[]
}

model Product {
  slug        String @unique
  name        String
  tagline     String
  description String @db.Text
  
  price       Float

  images      ProductImage[]
  metadata    ProductMetadata[]
  variants    ProductVariant[]
  reviews     ProductReview[]

  visible     Boolean @default(true)

  brand       Brand @relation(fields: [brandSlug], references: [slug])
  brandSlug   String

  seoDescription String?

  created     DateTime @default(now())
}

model ProductImage {
  id        String @id @default(uuid())
  alt       String
  source    String

  product     Product @relation(fields: [productSlug], references: [slug])
  productSlug String
}

model ProductMetadata {
  id        String @id @default(uuid())

  key       String
  value     String

  product     Product @relation(fields: [productSlug], references: [slug])
  productSlug String
}

model ProductVariant {
  id        String @id @default(uuid())
  name      String
  options   ProductVariantOption[]

  product     Product @relation(fields: [productSlug], references: [slug])
  productSlug String
}

model ProductVariantOption {
  id        String @id @default(uuid())
  name      String
  value     String
  stock     Int
  
  imageId   String?

  seoDescription String?

  variant   ProductVariant @relation(fields: [variantId], references: [id])
  variantId String
}

enum ProductReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model ProductReview {
  id          String @id @default(uuid())
  status      ProductReviewStatus @default(PENDING)
  rating      Int
  name        String
  title       String
  content     String @db.Text
  verified    Boolean @default(false)

  created     DateTime @default(now())

  product     Product @relation(fields: [productSlug], references: [slug])
  productSlug String
}

model Cart {
  id        String @id @default(uuid())
  created   DateTime @default(now())
  updated   DateTime @updatedAt

  items     CartItem[]

  converted  Boolean @default(false)

  couponId  String?
  coupon    Coupon? @relation(fields: [couponId], references: [id])
}

model CartItem {
  id        String @id @default(uuid())
  quantity  Int
  variants    CartItemVariant[]

  productSlug  String

  cart       Cart @relation(fields: [cartId], references: [id])
  cartId     String
}

model CartItemVariant {
  id        String @id @default(uuid())

  variantId String
  optionId String

  cartItem   CartItem @relation(fields: [cartItemId], references: [id])
  cartItemId String
}

enum CouponType {
  PERCENTAGE
  FIXED
}

model Coupon {
  id           String @id @default(uuid())
  code         String @unique
  discount     Float
  type         CouponType
  minimum      Float @default(0)

  created      DateTime @default(now())
  expiration   DateTime?

  carts        Cart[]
  orders       Order[]
}

enum OrderStatus {
  CANCELLED
  PENDING
  AWAITING_PAYMENT
  PROCESSING
  AWAITING_FULFILLMENT
  FULFILLED
}

model Order {
  id        String @id @default(uuid())
  status    OrderStatus @default(PENDING)

  email         String?
  phone         String?
  firstName     String?
  lastName      String?
  addressLine1  String?
  addressLine2  String?
  city          String?
  state         String?
  postal        String?
  country       String?

  items     OrderItem[]

  subtotal      Float?
  couponTotal   Float?
  shippingTotal Float?
  total         Float?

  coupon    Coupon? @relation(fields: [couponId], references: [id])
  couponId  String?

  paymentMethod String?
  paymentId     String?

  shippingMethod String?
  shippingCost   Float?
  shipments      OrderShipment[]

  created   DateTime @default(now())
  updated   DateTime @updatedAt
}

model OrderItem {
  id          String @id @default(uuid())
  quantity    Int
  variants    OrderItemVariant[]

  productSlug String
  price       Float?

  order       Order @relation(fields: [orderId], references: [id])
  orderId     String
}

model OrderItemVariant {
  id        String @id @default(uuid())

  variantId String
  optionId String

  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  orderItemId String
}

enum OrderShipmentStatus {
  PROCESSING
  SHIPPED
}

model OrderShipment {
  id           String @id @default(uuid())
  status       OrderShipmentStatus @default(PROCESSING)

  carrier      String
  tracking     String
  trackingUrl String?

  orderId String
  order   Order @relation(fields: [orderId], references: [id])
}

model BlogAuthor {
  id        String @id @default(uuid())
  name      String

  posts     BlogPost[]
}

model BlogCollection {
  id        String @id @default(uuid())
  slug      String @unique
  name      String

  posts     BlogPost[]
}

model BlogPost {
  id        String @id @default(uuid())
  slug      String @unique
  
  image     String
  title     String
  description String @db.Text
  content     String @db.Text

  collections BlogCollection[]
  
  author    BlogAuthor? @relation(fields: [authorId], references: [id])
  authorId  String?
  
  created   DateTime @default(now())
  updated   DateTime @updatedAt
}